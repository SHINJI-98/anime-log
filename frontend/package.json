{
  "name": "anime-log-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "electron:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --win portable",
    "test:desktop-assets": "npm run build && node tests/desktop-assets.test.cjs",
    "test:electron-main": "node --test tests/local-service.test.cjs tests/anilist-client.test.cjs tests/auto-launch.test.cjs tests/window-position.test.cjs tests/ball-input.test.cjs",
    "test:packaged": "node tests/packaged-smoke.cjs",
    "test:startup:windows": "node tests/auto-launch-windows.cjs",
    "test:e2e": "npm run build && node tests/desktop-assets.test.cjs && npm run test:electron-main && playwright test"
  },
  "dependencies": {
    "cheerio": "1.0.0",
    "sql.js": "1.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.3",
    "vue": "^3.5.17",
    "vite": "^5.4.19",
    "@vitejs/plugin-vue": "^5.2.4"
  },
  "build": {
    "appId": "com.animelog.desktop",
    "productName": "Anime Log",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/app-icon.png",
      "package.json",
      "!node_modules/sql.js/dist/**",
      "node_modules/sql.js/dist/sql-wasm.js",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "win": {
      "icon": "assets/app-icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Anime-Log-${version}-portable.${ext}"
    },
    "compression": "maximum"
  }
}
